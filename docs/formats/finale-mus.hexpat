#pragma description Finale .mus decompressed pools
#pragma magic [ 46 4D 55 53 ] @ 0x00  // "FMUS"

// GENERATED by scripts/hexpat -- do not edit.
//
// This pattern reads the file `finale-parser extract` writes, NOT a .mus. A
// .mus keeps its pools compressed, and the 2001-2005 era uses PKWARE implode,
// which ImHex cannot decompress. Run:
//
//     finale-parser extract score.mus     -> score.pools.bin
//
// and open that. The chain below is the .mus container's own framing -- kind,
// length, checksum -- with each payload decompressed in place.

import std.core;
import std.mem;

enum PoolKind : u16 {
    others  = 15,
    details = 16,
    entries = 17,
    text    = 18,
};

enum Era : u8 {
    zlib_2011 = 0,
    dcl_2005  = 1,
};

struct Header {
    char magic[4];
    u8 version;
    u8 order;          // 0 little, 1 big -- applies to everything after this header
    Era era;
    u8 pools;
};


// A 2011 pool is a run of self-identifying, variable-length records, with two
// bytes of 0x0000 / 0xFFFF filler between some of them. A record occupies
// 14 + length + extra_length bytes for `others` and 16 + length + extra_length
// for `details`.
//
// The four bytes after the payload are the LENGTH OF AN EXTRA BLOCK, not a
// fixed four-byte trailer: the trailer reading is retracted in
// docs/ARCHITECTURE.md, and enigma.mus_others._walk / mus_details._walk read
// `extra` bytes after it. The block is empty on 99.4% of records, which is why
// the trailer reading survived so long; where it is not, it is 24, 48 or 96
// bytes, and treating it as fixed desynchronizes every record after that one.
struct OthersRecord {
    u16 tag;
    if (tag != 0x0000 && tag != 0xFFFF) {
        u16 cmper;
        u16 part;
        u32 length;
        u8 payload[length];
        u32 extra_length;
        u8 extra[extra_length];
    }
    // Otherwise `tag` was two bytes of filler rather than a record header, and
    // the next record starts straight after it -- which is what the readers do,
    // and what keeps the walk in step.
};

struct DetailsRecord {
    u16 tag;
    if (tag != 0x0000 && tag != 0xFFFF) {
        u16 cmper1;
        u16 cmper2;
        u16 inci;
        u32 length;
        u8 payload[length];
        u32 extra_length;
        u8 extra[extra_length];
    }
    // Filler is skipped two bytes at a time here too.
};

// A 2001-2005 pool is a table of fixed 16-byte rows carrying ETF's
// two-character tags. The tag is a u16, NOT two characters: on a little-endian
// file its letters come out reversed, so `^MS` is stored `SM`. Reading the pair
// verbatim finds no known tag in 102 of 139 corpus documents.
//
// A record too big for one row runs on into further rows under the same tag and
// key -- ETF calls each row an incidence -- so a row is a fragment of a record,
// not a record.
//
// Row size is enigma.mus_rows._ROW (16 bytes). The two `data` sizes below are
// that row size minus each row's prefix: 16 - 4 (cmper + tag) = 12 for
// `others`, 16 - 6 (cmper1 + cmper2 + tag) = 10 for `details` -- see
// enigma.mus_rows._OTHERS_DATA and _DETAILS_DATA, which are private to that
// module so are not imported here.
struct DclOthersRow {
    u16 cmper;
    u16 tag;
    u8 data[12];
};

struct DclDetailsRow {
    u16 cmper1;
    u16 cmper2;
    u16 tag;
    u8 data[10];
};

struct PoolEntry {
    PoolKind kind;
    u32 length;
    if (length != 6) {
        u32 checksum;   // always 0: the container's checksum covers the
                        // COMPRESSED stream, which this file does not hold
        u64 payload_end = $ + length - 10;

        // Which shape a payload has is the header's era and this entry's kind
        // -- the same two things the parser dispatches on. `entries` and `text`
        // have no catalogued record shape, so they stay raw bytes rather than
        // being given an invented one.
        if (header.era == Era::zlib_2011 && kind == PoolKind::others) {
            OthersRecord records[while($ < payload_end)];
        } else if (header.era == Era::zlib_2011 && kind == PoolKind::details) {
            DetailsRecord records[while($ < payload_end)];
        } else if (header.era == Era::dcl_2005 && kind == PoolKind::others) {
            DclOthersRow rows[while($ < payload_end)];
        } else if (header.era == Era::dcl_2005 && kind == PoolKind::details) {
            DclDetailsRow rows[while($ < payload_end)];
        } else {
            u8 payload[length - 10];
        }

        if ($ != payload_end) {
            // The records did not tile the payload exactly. Skipping to the
            // entry's stated end keeps every later entry at its real offset; if
            // the walk overran instead, this length underflows and ImHex stops
            // here -- loudly, which a quietly shifted chain would not be.
            padding[payload_end - $];
        }
    }
};


// ---- record payloads, generated from formats/layouts.py ----

// measSpec -- tag 176, DCL ^MS
struct MeasSpec {
    u16 width;    // measure width in EVPU
    u16 key;    // key signature; 0 means inherit
    u16 beats;    // time signature numerator
    u16 divbeat;    // EDU per beat; 1024 = quarter
    padding[2];
    u16 flags;    // low byte holds the barline nibble
};

// FrameSpec (tag 146, DCL ^FR) is NOT laid out here. Its reader works out where
// the fields sit per record or era, so these offsets are the shape a reader
// starts from rather than where the bytes are. Laying it over a record would
// show confident, wrong values, so the payload stays raw.

// GfHold (tag 1044, DCL ^GF) is NOT laid out here. Its reader works out where
// the fields sit per record or era, so these offsets are the shape a reader
// starts from rather than where the bytes are. Laying it over a record would
// show confident, wrong values, so the payload stays raw.

// staffSpec -- tag 231, DCL ^IS
struct StaffSpec {
    padding[20];
    u16 transposition;    // written-to-sounding interval
};

// tupletDef -- tag 1072
struct TupletDef {
    u16 symbolicNum;    // printed count, the 3 of a triplet
    u16 symbolicDur;    // printed unit in EDU
    u16 refNum;    // count these replace
    u16 refDur;    // unit they replace, in EDU
};

// staffGroup -- tag 1057
struct StaffGroup {
    u16 startInst;    // first staff in the group
    u16 endInst;    // last staff, inclusive
    padding[6];
    u16 bracketId;    // bracket shape
    padding[9];
    u8 barlineFlags;    // bit 0: barlines cross the group
};

// lyricVerse -- tag 1108
struct LyricVerseSlot {
    u16 number;    // verse number
    u16 syll;    // syllable index into the text pool
    padding[4];
    u16 wext;    // non-zero: word extends with a melisma
    padding[10];
};
// LyricVerseSlot: the payload is an array of 20-byte LyricVerseSlot slots, not one structure.

// articAssign -- tag 1009
struct ArticAssign {
    u16 definition;    // key of the articDef this uses
};

// instUsed -- tag 159
struct InstUsedSlot {
    u16 staff;    // staff number, one per incidence
    padding[22];
};
// InstUsedSlot: the payload is an array of 24-byte InstUsedSlot slots, not one structure.

// textExprDef -- tag 241
struct TextExprDef {
    u16 textIDKey;    // points at the expression text; not its number
    padding[2];
    u16 value;    // playback level; the velocity for a dynamic
    u16 auxdata1;    // purpose unknown; agrees with the .musx field of that name
    u16 playPass;    // which repeat pass it plays on
    padding[2];
    u16 horzMeasExprAlign;    // 1 startTimeSig, 3 manual, 13 leftOfPrimaryNotehead, 14 rightOfAllNoteheads
    padding[10];
    u16 vertMeasExprAlign;    // 2 manual, 4 topNote, 8 aboveStaffOrEntry, 9 belowStaffOrEntry
    padding[4];
    s16 yAdjustBaseline;    // vertical offset from the baseline, in EVPU
    s16 yAdjustEntry;    // vertical offset from the entry, in EVPU
    padding[2];
    char descStr[];    // the marking in words, NUL-terminated, runs to the end
};

// textExprDef -- DCL ^DT
struct TextExprDefDcl {
    u16 counter;    // runs with cmper; the 2011 record has textIDKey here
    padding[2];
    u16 value;    // playback level; read in the document's byte order
    padding[30];
    char descStr[];    // the marking in words, NUL-terminated, runs to the end
};

// measExprAssign -- tag 177
struct MeasExprAssignSlot {
    u16 textExprID;    // names a textExprDef; a shapeExprID when +11 has 0x20
    s16 horzEduOff;    // horizontal offset in EDU, along the measure
    s16 horzEvpuOff;    // horizontal offset in EVPU
    s16 vertOff;    // vertical offset in EVPU
    s16 staffAssign;    // the staff, or -1 for a staff list
    padding[1];
    u8 flags;    // 0x20 marks a shape assignment rather than a text one
    u16 staffGroup;    // the group, on a staff-list assignment
    u16 staffList;    // which staff list, on a staff-list assignment
    padding[8];
};
// MeasExprAssign: the payload is an array of 24-byte MeasExprAssignSlot slots, not one structure.


// ---- which struct reads which tag ----
//   details  tag 1009               -> ArticAssign
//   details  tag 1057               -> StaffGroup
//   details  tag 1072               -> TupletDef
//   details  tag 1108               -> LyricVerseSlot
//   others   DCL ^DT                -> TextExprDefDcl
//   others   tag 159                -> InstUsedSlot
//   others   tag 176, DCL ^MS       -> MeasSpec
//   others   tag 177                -> MeasExprAssignSlot
//   others   tag 231, DCL ^IS       -> StaffSpec
//   others   tag 241                -> TextExprDef
// A tag not listed above has no catalogued layout: its payload stays raw bytes
// rather than being given an invented structure.
//
// THE DCL ARROWS DO NOT POINT AT A ROW. In that era a record's payload is the
// concatenation of its rows' data -- 12 bytes from each `others` row at +4, 10
// from each `details` row at +6 -- so a struct above must be laid over that
// gathered payload, never over a row. StaffSpec's field at +20 lives in the
// second row's data and TextExprDefDcl's at +36 in the fourth; placed at a row
// start, either one reads the next row's cmper and tag as a field value and
// shows a confident, wrong number.


Header header @ 0x00;

fn init() {
    std::core::set_endian(
        header.order == 1 ? std::mem::Endian::Big : std::mem::Endian::Little
    );
};

init();

PoolEntry pools[header.pools] @ 8;
